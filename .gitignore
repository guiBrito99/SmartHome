# Local runtime data generated by openHAB at boot
openhab/userdata/cache/
openhab/userdata/config/
openhab/userdata/jsondb/
openhab/userdata/logs/
openhab/userdata/secrets/
openhab/userdata/tmp/*
!openhab/userdata/tmp/README

# Machine-specific credentials / keys (rewritten at first boot — never commit)
openhab/userdata/etc/users.properties
openhab/userdata/etc/keys.properties
openhab/userdata/etc/keystore

# User-created configuration — keep only the templates shipped in the package
openhab/conf/**/*.items
openhab/conf/**/*.rules
openhab/conf/**/*.things
openhab/conf/**/*.sitemap
openhab/conf/**/*.script
