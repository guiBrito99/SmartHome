#!/bin/bash

# ============================================================
# Smart Home - Server Control
# Main entry point of the project.
#
#   ./run                           -> start the web server and stop here
#   ./run --menu                    -> interactive terminal menu
#   ./run --start                   -> start the server
#   ./run --stop                    -> stop the server
#   ./run --reboot                  -> restart the server
#   ./run --config                  -> configure add-ons
#   ./run --install                 -> install, configure, start and verify
#   ./run --update                  -> update openHAB
#   ./run --factory-reset           -> wipe and restore the project
#
# Every mode starts the web server (webServer/) before doing anything
# else, so the pages are served during and after the openHAB work.
# Plain ./run does nothing else: the web UI on port 8081 is the
# control panel, and --menu is there for the terminal.
# ============================================================

# Re-run this script with sudo if it was started without root privileges.
if [ "$EUID" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

# Absolute paths derived from the script location (cwd-independent).
var_SCRIPT_DIR="$(cd "$(dirname "$0")/scripts/main" && pwd)"

# Load the internal helper functions (get_server_status for the menu)
# and the shared project paths.
source "$var_SCRIPT_DIR/../internal/util"

# Print the menu header and the current server status on screen.
show_menu() {
    clear
    echo "=========================================="
    echo "      Smart Home - Server Control"
    echo "=========================================="
    echo ""
    var_STATUS="$(get_server_status)"
    echo "  Server Status: $var_STATUS"
    echo ""
    echo "  1) Start server"
    echo "  2) Stop server"
    echo "  3) Reboot server"
    echo "  4) Configure add-ons"
    echo "  5) Install"
    echo "  6) Update server"
    echo "  7) Factory reset"
    echo "  8) Exit"
    echo ""
    echo "=========================================="
}

# Prompt the user to enter a menu choice and print the answer.
read_choice() {
    local var_choice
    read -r -p "Enter your choice [1-8]: " var_choice
    echo "$var_choice"
}

# Run one of the operation scripts, then wait for the user to press Enter.
# Returns the exit status of the executed script.
run_script() {
    local var_script_name="$1"

    echo "Running $var_script_name..."
    "$var_SCRIPT_DIR/$var_script_name"
    var_RUN_STATUS=$?
    echo ""
    read -r -p "Press Enter to continue..."
    return $var_RUN_STATUS
}

# Map a CLI mode name (--<mode>) to the script that implements that operation.
mode_to_script() {
    case "$1" in
        start)          echo "start_server" ;;
        stop)          echo "stop_server" ;;
        reboot)        echo "reboot_server" ;;
        config)        echo "config_server" ;;
        install)        echo "install" ;;
        update)        echo "update_server" ;;
        factory-reset)  echo "factoryReset_server" ;;
        menu)          echo "" ;;   # handled by main, no script to call
        *)              return 1 ;;
    esac
}

# Non-interactive mode: run a single operation selected via --<mode>.
# --menu is not an operation: it is dispatched by main before we get here.
cli_mode() {
    local var_mode="$1"
    local var_script_name
    var_script_name=$(mode_to_script "$var_mode") || {
        echo "Unknown mode: '$var_mode'"
        echo "Usage: $0 --[menu|start|stop|reboot|config|install|update|factory-reset]"
        return 1
    }
    [ -n "$var_script_name" ] || return 1
    echo "Running $var_script_name..."
    "$var_SCRIPT_DIR/$var_script_name" || return 1
}

# Interactive mode: keep showing the menu until the user picks "Exit" (8).
# A failed operation returns to the menu instead of aborting it.
menu_mode() {
    local var_choice=0
    while [[ $var_choice -ne 8 ]]; do
        show_menu
        var_choice=$(read_choice)
        case "$var_choice" in
            1) run_script "start_server" ;;
            2) run_script "stop_server" ;;
            3) run_script "reboot_server" ;;
            4) run_script "config_server" ;;
            5) run_script "install" ;;
            6) run_script "update_server" ;;
            7) run_script "factoryReset_server" ;;
            8) echo "Exiting..." ; return 0 ;;
            *) echo "Invalid choice. Please try again." ; sleep 1 ;;
        esac
    done
}

# Entry point: bring up the web UI, then dispatch to the menu (--menu or no
# args) or CLI mode (a single other --flag).
main() {
    # The web server goes up first so the pages are served while the
    # openHAB functions run. A web problem only warns: the openHAB work
    # still has to happen. Captured so only its URL is printed here.
    local var_WEB_URL
    var_WEB_URL="$(start_web_server)"
    if [ -n "$var_WEB_URL" ]; then
        echo "Web UI: $var_WEB_URL"
    fi

    if [[ $# -eq 0 ]]; then
        # No flag: the web UI is the control panel, so say where it is and
        # stop. The terminal menu is opt-in with --menu.
        echo "Use './run --menu' for the terminal menu."
        return 0
    elif [[ $# -eq 1 ]]; then
        if [[ $1 != --* ]]; then
            echo "Error: Invalid flag structure"
            return 1
        fi
        if [[ $1 == --menu ]]; then
            menu_mode || return 1
            return 0
        fi
        echo "Running cli mode"
        cli_mode "${1#--}" || return 1
    else
        echo "Error: Only one flag can be used in cli mode"
        return 1
    fi
}

# Execute the entry point and exit with its status (single exit point).
main "$@"
var_STATUS=$?
exit $var_STATUS